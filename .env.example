# Copy to .env.local for local use; set these public values in Vercel for production.
# Use YOUR Timadashouse Convex deployment; do not reuse Calary's database.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_IMAGEKIT_PUBLIC_KEY=
VITE_IMAGEKIT_URL_ENDPOINT=
VITE_IMAGEKIT_FOLDER=/timadashouse/beauty
# Never place STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, ADMIN_ENROLLMENT_SECRET,
# IMAGEKIT_PRIVATE_KEY or auth signing keys in any VITE_ variable.
